{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "outDir": "../.tmp-speed-test",
    "rootDir": ".."
  },
  "include": [
    "verify-speed-folds.ts",
    "../src/modelName.ts",
    "../src/merge.ts",
    "../src/types.ts"
  ]
}
