<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      禁用 App Nap：防止 macOS 在应用空闲（长时间不点面板）/ 系统低功耗时
      把 WKWebView 进程休眠。否则再次唤起面板时 WebView 要从休眠中恢复渲染，
      出现 2-3 秒白屏。LSAppNapDisabled 是 Apple 官方禁用 App Nap 的 key。
    -->
    <key>LSAppNapDisabled</key>
    <true/>

    <!--
      作为"菜单栏工具"运行：不显示 Dock 图标、不显示主菜单栏，只保留托盘图标。
      dev 模式下裸二进制靠 set_activation_policy(Accessory) 即可隐藏 Dock；
      但打包成 .app 后必须靠 Info.plist 的 LSUIElement 在启动时就声明为
      accessory 应用，否则 macOS 会先按普通应用启动、Dock 图标常驻不消失。
    -->
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
